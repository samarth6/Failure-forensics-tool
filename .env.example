# Copy to .env (gitignored) and fill in the keys you have.

# --- Local inference: the four pipeline steps. No key needed. ---
FFX_OLLAMA_HOST=http://127.0.0.1:11434
FFX_PIPELINE_MODEL=llama3.2:3b

# --- LLM judge: free cloud tiers, tried in order Groq -> Gemini -> local. ---
# Leave a key empty to skip that provider. With neither key set, the judge uses the
# local model (weaker: it is the pipeline's own model grading itself).
#
# Groq:   free key, no card, at https://console.groq.com/keys
FFX_GROQ_API_KEY=
FFX_GROQ_MODEL=openai/gpt-oss-120b
#
# Gemini: free key, no card, at https://aistudio.google.com/apikey
FFX_GEMINI_API_KEY=
FFX_GEMINI_MODEL=gemini-3.5-flash-lite
#
# Free-tier model names change. If `python -m ffx doctor` reports a model as not found,
# override the model variable above - no code change needed.
